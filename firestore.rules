rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zero Trust Client-Side Security Policy
    // Browser/client direct read and write access to all collections is strictly DENIED.
    // The Node.js Express backend connects via Firebase Admin SDK (with IAM / ADC),
    // bypassing Firestore rules at the infrastructure level.

    match /leads/{document=**} {
      allow read, write: if false;
    }

    match /admin_sessions/{document=**} {
      allow read, write: if false;
    }

    match /lead_status_history/{document=**} {
      allow read, write: if false;
    }

    match /providers/{document=**} {
      allow read, write: if false;
    }

    match /analytics_events/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
