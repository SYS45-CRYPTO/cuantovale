rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{leadId} {
      allow read, write: if true;
    }
    match /providers/{providerId} {
      allow read, write: if true;
    }
    match /lead_status_history/{historyId} {
      allow read, write: if true;
    }
    match /analytics_events/{eventId} {
      allow read, write: if true;
    }
  }
}
